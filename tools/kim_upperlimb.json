{
  "tool": "KIM-MHO",
  "name": "KIM 手工物料作業",
  "description": "評估上肢反覆動作作業（如裝配/包裝）的肌肉骨骼風險。",
  "variables": [
    {"key": "duration", "label": "每日累計作業時間", "unit": "小時", "type": "number", "min": 0.5, "max": 10, "step": 0.5, "hint": "此子作業一天中累計持續的時數", "required": true},
    {"key": "forceLevelLeft", "label": "左手用力類型", "type": "select", "options": [ {"value": "low", "label": "低（~15% MVC）"}, {"value": "medium", "label": "中（~30% MVC）"}, {"value": "high", "label": "高（~50% MVC）"}, {"value": "veryHigh", "label": "很高（~80% MVC）"}, {"value": "peak", "label": "峰值（>80% MVC）"}, {"value": "impact", "label": "衝擊用力"} ], "hint": "左手在作業循環中的用力類型粗分", "required": true},
    {"key": "forceLevelRight", "label": "右手用力類型", "type": "select", "options": [ {"value": "low", "label": "低（~15% MVC）"}, {"value": "medium", "label": "中（~30% MVC）"}, {"value": "high", "label": "高（~50% MVC）"}, {"value": "veryHigh", "label": "很高（~80% MVC）"}, {"value": "peak", "label": "峰值（>80% MVC）"}, {"value": "impact", "label": "衝擊用力"} ], "hint": "右手在作業循環中的用力類型", "required": true},
    {"key": "holdTime", "label": "平均握持時間", "unit": "秒/分", "type": "number", "min": 0, "max": 60, "hint": "每分鐘內持續握持（用力）累計的秒數", "required": true},
    {"key": "moveCount", "label": "平均動作頻率", "unit": "次/分", "type": "number", "min": 0, "max": 120, "hint": "每分鐘內手部重複動作的次數", "required": true},
    {"key": "grip", "label": "抓握/工具條件", "type": "select", "options": [ {"value": 0, "label": "良好：易握持，人體工學設計良好（0分）"}, {"value": 2, "label": "受限：需較大握力/無良好握把（+2分）"}, {"value": 4, "label": "很差：難以抓握/無適當握把（+4分）"} ], "hint": "物件或手工具的握持難易程度", "required": true},
    {"key": "handPosture", "label": "手部姿勢穩定性", "type": "select", "options": [ {"value": 0, "label": "良好：關節姿勢放鬆、無長時間固定（0分）"}, {"value": 1, "label": "受限：偶爾達極限/偶有靜態用力（+1分）"}, {"value": 2, "label": "不良：頻繁達極限/長時間靜態（+2分）"}, {"value": 3, "label": "很差：持續極限姿勢/固定不動（+3分）"} ], "hint": "上肢關節位置是否常處於不自然或固定狀態", "required": true},
    {"key": "conditions", "label": "不良環境因素", "type": "select", "options": [ {"value": 0, "label": "無明顯不良（0分）"}, {"value": 1, "label": "稍有干擾（+1分）"}, {"value": 2, "label": "持續干擾（+2分）"} ], "hint": "作業環境中影響員工作業舒適性的因素程度", "required": true},
    {"key": "bodyPosture", "label": "全身姿勢", "type": "select", "options": [ {"value": 0, "label": "良好：可坐站交替/姿勢自然（0分）"}, {"value": 2, "label": "受限：偶有前傾/手高舉等（+2分）"}, {"value": 4, "label": "不良：常前傾/需頻繁曲身（+4分）"}, {"value": 6, "label": "很差：嚴重前傾或扭曲姿勢（+6分）"} ], "hint": "整體工作姿勢是否不良，如長期彎腰、蹲跪等", "required": true},
    {"key": "organization", "label": "工作組織", "type": "select", "options": [ {"value": 0, "label": "良好：多樣工作交替（0分）"}, {"value": 2, "label": "受限：偶爾單一高負荷（+2分）"}, {"value": 4, "label": "不良：長時間單一高負荷（+4分）"} ], "hint": "一天中此上肢作業是否與其他工作交替進行", "required": true}
  ],
